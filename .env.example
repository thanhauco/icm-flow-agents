# Azure AI Foundry Configuration
AZURE_OPENAI_ENDPOINT=https://your-foundry-endpoint.azure.com
AZURE_OPENAI_API_KEY=your-api-key
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# GPT-5.2 Model Deployments
AZURE_GPT52_DEPLOYMENT_NAME=gpt-5-2
AZURE_GPT52_CHAT_DEPLOYMENT_NAME=gpt-5-2-chat
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5-2
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=gpt-5-2-chat
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# Managed identity (Azure-hosted)
AZURE_CLIENT_ID=

# Azure AI Search (Vector Store)
AZURE_AI_SEARCH_ENDPOINT=https://your-search-endpoint.search.windows.net
AZURE_AI_SEARCH_KEY=your-search-key
AZURE_AI_SEARCH_INDEX_NAME=icm-incidents
AZURE_AI_SEARCH_INDEX=incidents

# Azure Cosmos DB (Memory Store)
AZURE_COSMOS_ENDPOINT=https://your-cosmos-account.documents.azure.com:443/
AZURE_COSMOS_CONNECTION_STRING=your-cosmos-connection-string
AZURE_COSMOS_DATABASE_NAME=icm-flow-agents
AZURE_COSMOS_CONTAINER_NAME=agent-memory
AZURE_COSMOS_DATABASE=icm-flow-agents
AZURE_COSMOS_MEMORY_CONTAINER=agent-memory
AZURE_COSMOS_HISTORY_CONTAINER=execution-history

# Application Insights (Observability)
APPLICATIONINSIGHTS_CONNECTION_STRING=your-app-insights-connection-string

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Agent Configuration
MAX_TOKENS=4096
TEMPERATURE=0.7
MAX_RETRIES=3
TIMEOUT_SECONDS=300
REQUEST_TIMEOUT_SECONDS=60

# Cost Control
MAX_COST_PER_INCIDENT=5.0
DAILY_COST_LIMIT=1000.0

# Safety & Governance
ENABLE_PII_REDACTION=true
ENABLE_PROMPT_INJECTION_DETECTION=true
ENABLE_CONTENT_FILTERING=true
